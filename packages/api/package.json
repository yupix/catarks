{
  "name": "@catarks/api",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "prebuild": "rimraf dist",
    "build": "npx swc src -d dist -D",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "HMR=true node -r @swc/register src/hmr.ts",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json"
  },
  "dependencies": {
    "@blazity/nest-file-fastify": "^1.0.0",
    "@catarks/db": "workspace:^1.0.0",
    "@catarks/shared": "workspace:^0.0.1",
    "@fastify/multipart": "^7.3.0",
    "@fastify/secure-session": "^5.2.0",
    "@fastify/static": "^6.6.0",
    "@fastify/view": "^7.3.0",
    "@nestjs-modules/ioredis": "^1.0.1",
    "@nestjs/bull": "^0.6.2",
    "@nestjs/common": "^9.0.0",
    "@nestjs/core": "^9.0.0",
    "@nestjs/platform-express": "^9.0.0",
    "@nestjs/platform-fastify": "^9.2.0",
    "@nestjs/swagger": "^6.1.4",
    "@nicholas.braun/nestjs-redoc": "^2.2.3",
    "@ntegral/nestjs-sentry": "^4.0.0",
    "@sentry/node": "^7.30.0",
    "aws-sdk": "^2.1287.0",
    "blurhash": "^2.0.4",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.13.2",
    "fastify-multer": "^2.0.3",
    "handlebars": "^4.7.7",
    "ioredis": "^5.2.4",
    "jdenticon": "^3.2.0",
    "mime-types": "^2.1.35",
    "nest-aws-sdk": "^3.0.0",
    "nestjs-pino": "^3.1.1",
    "pino-http": "^8.2.1",
    "pino-pretty": "^9.1.1",
    "reflect-metadata": "^0.1.13",
    "rimraf": "^3.0.2",
    "rxjs": "^7.2.0",
    "ts-md5": "^1.3.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^9.0.0",
    "@nestjs/schematics": "^9.0.0",
    "@nestjs/testing": "^9.0.0",
    "@swc/cli": "^0.1.59",
    "@swc/core": "^1.3.24",
    "@swc/helpers": "^0.4.14",
    "@swc/register": "^0.1.10",
    "@types/bull": "^4.10.0",
    "@types/express": "^4.17.13",
    "@types/jest": "28.1.8",
    "@types/node": "^16.0.0",
    "@types/supertest": "^2.0.11",
    "@typescript-eslint/eslint-plugin": "^5.0.0",
    "@typescript-eslint/parser": "^5.0.0",
    "chokidar": "^3.5.3",
    "eslint": "^8.0.1",
    "eslint-config-prettier": "^8.3.0",
    "eslint-plugin-prettier": "^4.0.0",
    "jest": "28.1.3",
    "prettier": "^2.3.2",
    "source-map-support": "^0.5.20",
    "supertest": "^6.1.3",
    "ts-jest": "28.0.8",
    "ts-loader": "^9.2.3",
    "ts-node": "^10.0.0",
    "tsconfig-paths": "4.1.0",
    "typescript": "^4.7.4"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}