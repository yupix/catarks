{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "skipLibCheck": false,
    "allowJs": true,
    "declaration": true,
    "sourceMap": true,
    "baseUrl": "./",
    "rootDir": "./src",
    "outDir": "./built",
    "paths": {
      "@/*": [
        "./src/*"
      ]
    },
    "plugins": [
      {
        "transform": "tsc-progress",
        "title": "@catarks/utils"
      }
    ]
  },
  "include": [
    "./**/*.ts"
  ],
  "exclude": [
    "./built/**/*"
  ]
}
