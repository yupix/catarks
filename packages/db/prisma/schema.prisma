generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model AbilityEffects {
  name      String      @id
  percent   Boolean
  effect    String
  abilities Abilities[]
}

model Abilities {
  name    String           @id
  items   Items[]
  effects AbilityEffects[]
}

model DropArias {
  name  String  @id
  Items Items[]
}

model Items {
  id            String       @id @default(uuid())
  name          String       @unique
  rarity        Int
  type          ItemTypes
  abilitiesName String?
  ability       Abilities?   @relation(fields: [abilitiesName], references: [name])
  iconUrl       String
  prices        ItemPrices[]
  droparias     DropArias[]
}

model ItemPrices {
  id         String   @id @default(uuid())
  price      Int
  reporter   Users    @relation(fields: [reporterId], references: [id])
  items      Items[]
  ship       Int
  reporterId String
  createdAt  DateTime @default(now())
}

model Users {
  id         String        @id @default(uuid())
  username   String        @unique
  password   String
  avatarUrl  String?
  ItemPrices ItemPrices[]
  discordId  String?
  ship       Int           @default(8)
  bannerUrl  String?
  settings   UserSettings?
  createdAt  DateTime      @default(now())
}

model UserSettings {
  id           String  @id @default(uuid())
  useDarkTheme Boolean @default(false)
  Users        Users   @relation(fields: [usersId], references: [id])
  usersId      String  @unique
}

enum ItemTypes {
  ability
}
