generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model AbilityEffects {
  name      String      @id
  percent   Boolean
  effect    String
  abilities Abilities[]
}

model Abilities {
  name    String           @id
  items   Items[]
  effects AbilityEffects[]
}

model Items {
  id            String       @id @default(uuid())
  name          String       @unique
  rarity        Int
  type          ItemTypes
  abilitiesName String?
  ability       Abilities?   @relation(fields: [abilitiesName], references: [name])
  prices        ItemPrices[]
  iconUrl       String
}

model ItemPrices {
  id         String  @id @default(uuid())
  price      Int
  reporter   Users   @relation(fields: [reporterId], references: [id])
  items      Items[]
  reporterId String
}

model Users {
  id         String       @id @default(uuid())
  username   String       @unique
  password   String
  avatarUrl  String?
  ItemPrices ItemPrices[]
}

enum ItemTypes {
  ability
}
