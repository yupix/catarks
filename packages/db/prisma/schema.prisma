generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model AbilityEffects {
  name      String      @id
  percent   Boolean
  effect    String
  abilities Abilities[]
}

model Abilities {
  name    String           @id
  items   Items[]
  effects AbilityEffects[]
}

model DropArias {
  name  String  @id
  Items Items[]
}

model Items {
  id            String       @id
  name          String       @unique
  rarity        Int
  type          ItemTypes
  abilitiesName String?
  ability       Abilities?   @relation(fields: [abilitiesName], references: [name])
  iconUrl       String
  prices        ItemPrices[]
  droparias     DropArias[]
}

model ItemPrices {
  id         String   @id @default(uuid())
  price      Int
  reporter   Users    @relation(fields: [reporterId], references: [id], onDelete: Cascade)
  item       Items    @relation(fields: [itemId], references: [id])
  ship       Int
  reporterId String
  createdAt  DateTime @default(now())
  itemId     String
}

model DefaultAvatars {
  username String @id
  url      String @unique
}

model Files {
  hash     String @id
  filename String @unique
  url      String
  author   Users  @relation(fields: [userId], references: [id])
  userId   String
}

model Users {
  id          String        @id @default(uuid())
  username    String        @unique
  description String?
  avatarUrl   String?
  ItemPrices  ItemPrices[]
  discordId   String?
  ship        Int           @default(8)
  bannerUrl   String?
  settings    UserSettings?
  createdAt   DateTime      @default(now())
  Files       Files[]
}

model UserSettings {
  id           String  @id @default(uuid())
  useDarkTheme Boolean @default(false)
  User         Users   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId       String  @unique
}

enum ItemTypes {
  ability
  weapon
  armor
}
