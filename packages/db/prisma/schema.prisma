generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model AbilityEffects {
  name      String      @id
  percent   Boolean
  value     Float
  abilities Abilities[]
}

model Abilities {
  name    String           @id
  items   Items[]
  effects AbilityEffects[]
}

model DropArias {
  name  String  @id
  Items Items[]
}

model ItemPriceAverage {
  id        String   @id @default(uuid())
  ship      Int
  price     Int
  item      Items    @relation(fields: [itemsId], references: [id])
  createdAt DateTime
  itemsId   String
}

model Items {
  id               String             @id @default(uuid())
  name             String             @unique
  rarity           Int
  type             ItemTypes
  abilitiesName    String?
  ability          Abilities?         @relation(fields: [abilitiesName], references: [name])
  iconUrl          String
  prices           ItemPrices[]
  droparias        DropArias[]
  ItemPriceAverage ItemPriceAverage[]
}

model ItemPrices {
  id         String   @id @default(uuid())
  price      Int
  reporter   Users    @relation(fields: [reporterId], references: [id], onDelete: Cascade)
  item       Items    @relation(fields: [itemId], references: [id])
  ship       Int
  reporterId String
  createdAt  DateTime @default(now())
  itemId     String
}

model DefaultAvatars {
  username String @id
  url      String @unique
}

model Files {
  hash         String    @id
  filename     String    @unique
  UUIDFilename String    @unique
  url          String
  author       Users     @relation(fields: [userId], references: [id])
  userId       String
  Diaries      Diaries[]
}

model Users {
  id          String        @id @default(uuid())
  auth0Id     String
  username    String        @unique
  nickname    String?
  description String?
  avatarUrl   String?
  ItemPrices  ItemPrices[]
  discordId   String?
  ship        Int           @default(8)
  bannerUrl   String?
  settings    UserSettings?
  createdAt   DateTime      @default(now())
  Files       Files[]
  Diaries     Diaries[]
  role        UserRoles[]
  Teams       Teams[]
  leader      Teams[]       @relation("team_leader")
}

model Teams {
  id          String  @id @default(uuid())
  name        String
  description String?
  ship        Int
  leader      Users   @relation("team_leader", fields: [usersId], references: [id])
  members     Users[]
  usersId     String
}

model UserRoles {
  name            Roles   @id
  canCreateReport Boolean
  Users           Users?  @relation(fields: [usersId], references: [id])
  usersId         String?
}

model UserSettings {
  id            String  @id @default(uuid())
  useTheme      Themes  @default(winter)
  defaultUseTax Boolean @default(false)
  User          Users   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId        String  @unique
}

model Diaries {
  id        String @id @default(uuid())
  authorId  String
  filesHash String
  author    Users  @relation(fields: [authorId], references: [id])
  file      Files  @relation(fields: [filesHash], references: [hash])
}

enum Themes {
  light
  dark
  cupcake
  bumblebee
  emerald
  corporate
  synthwave
  retro
  cyberpunk
  valentine
  halloween
  garden
  forest
  aqua
  lofi
  pastel
  fantasy
  wireframe
  black
  luxury
  dracula
  cmyk
  autumn
  business
  acid
  lemonade
  night
  coffee
  winter
}

enum Roles {
  admin
  member
}

enum ItemTypes {
  ability
  weapon
  armor
  material
}
