{
  "extends": "@tsconfig/recommended/tsconfig.json",
  "compilerOptions": {
    "lib": ["ESNext"],
    "resolveJsonModule": true,
    "moduleResolution": "node",
    "declaration": true,
    "noEmitOnError": true,
    "allowSyntheticDefaultImports": true,
    "checkJs": false,
    "noUnusedLocals": false,
  },
  "exclude": [
    "node_modules"
  ]
}
